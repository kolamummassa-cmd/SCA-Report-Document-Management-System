# ─────────────────────────────────────────────────────────────
# SCA Report & Document Management System — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- General ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://sca_admin:changeme@localhost:5433/sca_rdms?schema=public"

# --- Redis (sessions cache, rate limiting, job queue) ---
REDIS_URL="redis://localhost:6379"

# --- Auth / JWT ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"
PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15

# --- File Storage ---
# provider: "local" | "s3" | "r2"
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=100

# S3 / R2 (used when STORAGE_PROVIDER is "s3" or "r2")
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Email (transactional) ---
# provider: "smtp" | "postmark" | "ses"
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS="no-reply@sca.or.ke"
EMAIL_FROM_NAME="SCA Report & Document Management System"

# --- CORS ---
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Backups ---
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=90
BACKUP_TARGET_PATH=./backups
